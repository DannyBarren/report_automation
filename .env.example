# JobDoc / GenerSwift — environment template.
# Copy to .env and fill in. Never commit .env.
#
# Outside JOBDOC_DEV=1 the process refuses to start if SECRET_KEY is unset,
# and if JOBDOC_AUTH_USER / JOBDOC_AUTH_PASSWORD are unset while the login
# gate is enabled.

# Flask session signing key (required in production). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Shared login (required unless JOBDOC_AUTH_DISABLE=1 or JOBDOC_DEV=1).
JOBDOC_AUTH_USER=
JOBDOC_AUTH_PASSWORD=

# Set to 1 only on a trusted private deploy to skip the login gate.
# JOBDOC_AUTH_DISABLE=1

# Local development only — never set on Hugging Face / Modal / production.
# Allows an ephemeral SECRET_KEY and turns the login gate off if auth env is unset.
# JOBDOC_DEV=1

# Drop the Secure cookie flag so login sticks on http://127.0.0.1
# JOBDOC_COOKIE_INSECURE=1

# Recommended capture pipeline (MARK taps + spoken cues).
JOBDOC_PIPELINE=v2

# Provider keys (or paste in the UI). Required to transcribe / write reports.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Optional
# PORT=7860
# FLASK_DEBUG=0
# JOBDOC_DISABLE_GPU=0
# JOBDOC_STT_BACKEND=deepgram
# JOBDOC_WHISPER_MODEL=small
# JOBDOC_MAX_VIDEO_SEC=
# JOBDOC_MAX_UPLOAD_MB=500
# JOBDOC_RETENTION_HOURS=24
# JOBDOC_RATELIMIT_UPLOAD=12
# JOBDOC_RATELIMIT_GENERATE=20
# JOBDOC_RATELIMIT_DISABLE=0
# JOBDOC_LOG=info
# JOBDOC_LOG_JSON=1
